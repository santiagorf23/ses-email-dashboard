# ============================================
# SES Mail Dashboard - Variables de Entorno
# ============================================
# Copiar este archivo a .env y completar los valores
# cp .env.example .env

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/ses_dashboard

# JWT Secret - Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERAR_CLAVE_AQUI

# Admin credentials
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR_PASSWORD_SEGURA

# CORS (orígenes permitidos, separados por coma)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8088