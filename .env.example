# ============================================
# SES Mail Dashboard - Variables de Entorno
# ============================================
# Copiar a .env y personalizar: cp .env.example .env
# Generar SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

# PostgreSQL
POSTGRES_DB=ses_dashboard
POSTGRES_USER=user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURA

# Backend
DATABASE_URL=postgresql://user:CAMBIAR_PASSWORD_SEGURA@db:5432/ses_dashboard
SECRET_KEY=GENERAR_CLAVE_AQUI
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR_PASSWORD_SEGURA

# CORS (orígenes permitidos)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8088

# ============================================
# AWS (para envío de emails vía SES)
# ============================================
# Obtener credenciales de: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1

# ============================================
# Webhook URL (para recibir eventos SES vía SNS)
# ============================================
# URL pública donde SNS enviará las notificaciones
WEBHOOK_URL=https://your-domain.com/api/webhooks/ses

# ============================================
# LemonSqueezy (Billing)
# ============================================
# Obtener credenciales de: https://dashboard.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=ls_xxx
LEMONSQUEEZY_STORE_ID=xxx
LEMONSQUEEZY_WEBHOOK_SECRET=xxx

# Product IDs (obtener después de crear productos)
LS_PRODUCT_STARTER_MONTHLY=xxx
LS_PRODUCT_STARTER_ANNUAL=xxx
LS_PRODUCT_PRO_MONTHLY=xxx
LS_PRODUCT_PRO_ANNUAL=xxx

# URLs de retorno
BILLING_SUCCESS_URL=https://app.getmailpulse.net/billing/success
BILLING_CANCEL_URL=https://app.getmailpulse.net/billing/cancel
