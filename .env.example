# ============================================
# SES Mail Dashboard - Variables de Entorno
# ============================================
# Copiar a .env y personalizar: cp .env.example .env
# Generar SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

# PostgreSQL
POSTGRES_DB=ses_dashboard
POSTGRES_USER=user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURA

# Backend
DATABASE_URL=postgresql://user:CAMBIAR_PASSWORD_SEGURA@db:5432/ses_dashboard
SECRET_KEY=GENERAR_CLAVE_AQUI
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR_PASSWORD_SEGURA

# CORS (orígenes permitidos)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8088
